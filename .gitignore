firebase-debug.log

# H5P working dirs and fetched client libraries, all under `apps/<app>/h5p/`.
# Anchored at `apps/*/` rather than `**/`: the API's own module is
# `apps/api/src/h5p/`, so a `**/h5p/<name>/` pattern silently ignores source
# directories inside it — a file added under `src/h5p/content/` would vanish
# from `git add` with no error anywhere.
apps/*/h5p/temporary-storage/
apps/*/h5p/core/
apps/*/h5p/editor/
apps/*/h5p/.assets.json
apps/*/h5p/.fetch-tmp/

# Agent loop working files: plans and per-issue state are scratch, not history.
.agent/
