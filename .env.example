# Copy to .env and adjust. Loaded by the API via @nestjs/config.

NODE_ENV=development
PORT=8080

GOOGLE_CLOUD_PROJECT=speakukrainian-local
STORAGE_BUCKET=speakukrainian-media

# Local emulators from `docker compose up`.
# The Firestore SDK reads FIRESTORE_EMULATOR_HOST itself — host:port, no scheme.
FIRESTORE_EMULATOR_HOST=localhost:8081
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Cloud Storage endpoint override. Intentionally not called
# STORAGE_EMULATOR_HOST: the Storage SDK special-cases that name and the two
# configuration paths conflict, which makes every object request 404.
STORAGE_API_ENDPOINT=http://localhost:4443

# Account created by `pnpm seed:admin` in the Auth emulator. Local only —
# the script refuses to run unless the emulator host variables above are set.
SEED_ADMIN_EMAIL=admin@speakukrainian.local
SEED_ADMIN_PASSWORD=password

CORS_ORIGINS=http://localhost:4200,http://localhost:4300
PUBLIC_SITE_URL=http://localhost:4300

H5P_TEMP_DIR=./h5p/temporary-storage

# Where the API *reads* the fetched H5P client libraries from, relative to
# apps/api. The fetch (`pnpm install`, or `pnpm h5p:fetch` to re-run it) always
# writes apps/api/h5p and never reads this, so pointing it elsewhere means
# putting the two trees there yourself — otherwise the asset routes 503.
H5P_ASSETS_DIR=./h5p

# Absolute in local dev, and it has to be: the admin runs on :4200 and the H5P
# client resolves these URLs against the *page's* origin, not the API's, so a
# relative path would look for the core scripts on the admin's dev server.
H5P_BASE_URL=http://localhost:8080/api/h5p

# Signs the short-lived per-user token the H5P editor's own client carries in
# the URLs it builds its requests from. Required, at least 32 characters, and
# deliberately EMPTY here: copying this file to .env and running refuses the
# boot rather than starting every developer and every deploy on one signing key
# that is published in this repository. Generate one with:
#
#   openssl rand -base64 48
#
# Rotating it invalidates every live editing session — an author reloads the
# screen and loses nothing, because saving uses a bearer token.
H5P_URL_TOKEN_SECRET=

# How long a content or library file may deliver nothing before the API gives
# up and answers. It measures silence, not duration: any byte restarts the
# clock, so a large clip over a slow link never trips it. Lower it only to make
# a stalled read observable in a test.
H5P_STREAM_STALL_TIMEOUT_MS=30000
