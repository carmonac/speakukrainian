{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["test/**/*.ts", "src/**/*.ts"],
  // Without this the inherited `exclude` (which lists `test`) filters the
  // `include` above back down to `src`, and the e2e files are typechecked by
  // nothing: SWC strips their types without checking them.
  "exclude": ["node_modules", "dist"]
}
